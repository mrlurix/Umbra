<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="BgPrimary">#0A0A1A</Color>
    <Color x:Key="BgSecondary">#12122A</Color>
    <Color x:Key="BgCard">#1A1A3E</Color>
    <Color x:Key="BgCardHover">#222250</Color>
    <Color x:Key="AccentCyan">#00D4FF</Color>
    <Color x:Key="AccentPurple">#A855F7</Color>
    <Color x:Key="AccentPink">#EC4899</Color>
    <Color x:Key="AccentGreen">#22C55E</Color>
    <Color x:Key="AccentRed">#EF4444</Color>
    <Color x:Key="AccentOrange">#F97316</Color>
    <Color x:Key="TextPrimary">#F1F5F9</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextDim">#64748B</Color>
    <Color x:Key="BorderColor">#2A2A5A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBgPrimary" Color="{StaticResource BgPrimary}" />
    <SolidColorBrush x:Key="BrushBgSecondary" Color="{StaticResource BgSecondary}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource BgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource BgCardHover}" />
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource AccentPurple}" />
    <SolidColorBrush x:Key="BrushAccentPink" Color="{StaticResource AccentPink}" />
    <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="BrushAccentRed" Color="{StaticResource AccentRed}" />
    <SolidColorBrush x:Key="BrushAccentOrange" Color="{StaticResource AccentOrange}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource TextDim}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderColor}" />

    <LinearGradientBrush x:Key="GradientAccent" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentCyan}" Offset="0" />
        <GradientStop Color="{StaticResource AccentPurple}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientButton" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1A3E" Offset="0" />
        <GradientStop Color="#222255" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientButtonHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#222255" Offset="0" />
        <GradientStop Color="#2A2A6A" Offset="1" />
    </LinearGradientBrush>

    <!-- Drop Shadows -->
    <DropShadowEffect x:Key="ShadowGlow" BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="{StaticResource AccentCyan}" />
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="15" ShadowDepth="3" Opacity="0.3" Color="#000000" />
    <DropShadowEffect x:Key="ShadowButton" BlurRadius="10" ShadowDepth="2" Opacity="0.4" Color="#000000" />

    <!-- Global Styles -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushBgPrimary}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style TargetType="ScrollBar" />

    <!-- ScrollViewer -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   Width="6"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,2,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border CornerRadius="3"
                                                    Background="{StaticResource BrushBgCard}"
                                                    BorderThickness="0"
                                                    Opacity="0.6" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Button Style -->
    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Effect" Value="{StaticResource ShadowButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            CornerRadius="10"
                            Background="{StaticResource GradientButton}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid>
                            <Border x:Name="glowBorder"
                                    CornerRadius="10"
                                    Opacity="0"
                                    Background="{StaticResource GradientAccent}" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.05"
                                                         Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource EaseOutBack}" />
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.05"
                                                         Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource EaseOutBack}" />
                                        <DoubleAnimation Storyboard.TargetName="glowBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.15"
                                                         Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="Background.GradientStops[0].Color"
                                                        To="#222255"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="glowBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.3" />
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="Background.GradientStops[0].Color"
                                                        To="#1A1A3E"
                                                        Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.95"
                                                         Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.95"
                                                         Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.05"
                                                         Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource EaseOutBack}" />
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.05"
                                                         Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource EaseOutBack}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent buttons (colored border) -->
    <Style x:Key="BtnCyan" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentCyan}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}" />
    </Style>

    <Style x:Key="BtnPurple" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentPurple}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccentPurple}" />
    </Style>

    <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentGreen}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccentGreen}" />
    </Style>

    <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentRed}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccentRed}" />
    </Style>

    <Style x:Key="BtnOrange" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentOrange}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccentOrange}" />
    </Style>

    <!-- Window Control Buttons -->
    <Style x:Key="WindowControlButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#30FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E81123" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ListBox / ListView -->
    <Style x:Key="ModernListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="border"
                            CornerRadius="10"
                            Background="{StaticResource BrushBgCard}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Margin="2,2"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="slideTransform" X="0" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slideTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="50"
                                                         To="0"
                                                         Duration="0:0:0.3"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="border"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                            <Border x:Name="selectionGlow"
                                    CornerRadius="10"
                                    Opacity="0"
                                    Background="{StaticResource GradientAccent}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushBgCardHover}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}" />
                            <Setter TargetName="selectionGlow" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}" />
                            <Setter TargetName="border" Property="Background" Value="#1A1A4A" />
                            <Setter TargetName="selectionGlow" Property="Opacity" Value="0.15" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernListBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="4">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox Style -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Cursor="Hand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="checkBorder"
                                Width="18" Height="18"
                                CornerRadius="5"
                                Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="checkScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Path x:Name="checkMark"
                                  Data="M4,8 L7.5,11.5 L13,5"
                                  Stroke="{StaticResource BrushAccentCyan}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="0" ScaleY="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" />
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="checkBorder"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource AccentCyan}"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="checkBorder"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource BorderColor}"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="checkScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.15"
                                                         Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="checkScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.15"
                                                         Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="checkMark"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="checkMark"
                                                         Storyboard.TargetProperty="(Path.RenderTransform).ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource EaseOutBack}" />
                                        <DoubleAnimation Storyboard.TargetName="checkMark"
                                                         Storyboard.TargetProperty="(Path.RenderTransform).ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource EaseOutBack}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="checkScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="checkScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="checkMark"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="checkMark"
                                                         Storyboard.TargetProperty="(Path.RenderTransform).ScaleX"
                                                         To="0"
                                                         Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="checkMark"
                                                         Storyboard.TargetProperty="(Path.RenderTransform).ScaleY"
                                                         To="0"
                                                         Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Easing Functions -->
    <BackEase x:Key="EaseOutBack" EasingMode="EaseOut" Amplitude="0.3" />
    <QuadraticEase x:Key="EaseOutQuad" EasingMode="EaseOut" />
    <QuadraticEase x:Key="EaseInOutQuad" EasingMode="EaseInOut" />
    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut" />
    <ElasticEase x:Key="EaseOutElastic" EasingMode="EaseOut" Oscillations="3" Springiness="0" />
    <BounceEase x:Key="EaseOutBounce" EasingMode="EaseOut" Bounces="3" Bounciness="1" />

</ResourceDictionary>
